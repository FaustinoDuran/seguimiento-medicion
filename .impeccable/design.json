  "narrative": {
    "northStar": "Herramienta operativa oscura inspirada en Linear, sin copiar marca",
    "overview": "Inter Variable local, carbón y capas neutras, acento índigo, bordes y luminancia sin sombras, densidad compacta. La referencia del usuario fija fuentes y colores; la identidad y los SVG geométricos pertenecen al producto.\n\nLa lectura prioriza títulos literales, datos y acciones. Texto claro, secundarios apagados y controles nativos mantienen una interfaz directa en español. El tamaño y el espacio distinguen jerarquías dentro de una sola familia sans.",
    "keyCharacteristics": [
      "Superficies oscuras con bordes finos.",
      "Una familia sans local y cifras tabulares en métricas e identificadores.",
      "Controles compactos, foco visible y adaptación móvil."
    ],
    "rules": [
      {
        "name": "The Luminance Rule",
        "body": "Separar regiones con capas neutras y bordes; los paneles no usan sombras.",
        "section": "elevation"
      },
      {
        "name": "The Single Family Rule",
        "body": "Usar Inter Variable para títulos, texto y cifras destacadas; el título principal conserva la escala compacta.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do conservar los tokens del frontmatter como referencia normativa.",
      "Do mantener controles nativos, etiquetas visibles y foco de teclado.",
      "Do permitir que títulos largos se ajusten y que tablas extensas se desplacen dentro de su región."
    ],
    "donts": [
      "Don't copiar la marca ni el contenido comercial de Linear.",
      "Don't agregar sombras o brillos a los paneles planos.",
      "Don't introducir una familia serif o titulares promocionales en el espacio operativo."
    ]
  }
}
